+@mcp.tool()
+async def get_planned_recipes_this_week() -> str:
+    """
+    Get all recipes planned in the Cookidoo calendar for the current week.
+
+    Returns a list of recipe IDs and names grouped by day.
+    Must be connected first using connect_to_cookidoo.
+
+    Returns:
+        str: Planned recipes grouped by day, with ID and name for each recipe.
+    """
+    global _cookidoo_api
+
+    if not _cookidoo_api:
+        return "Not connected. Please run 'connect_to_cookidoo' first."
+
+    try:
+        from datetime import date
+        days = await _cookidoo_api.get_recipes_in_calendar_week(date.today())
+
+        has_recipes = any(day.recipes for day in days)
+        if not days or not has_recipes:
+            return "No recipes planned for this week."
+
+        result = f"Planned recipes for week of {date.today().strftime('%d.%m.%Y')}:\n\n"
+        for day in days:
+            if day.recipes:
+                result += f"{day.title}:\n"
+                for recipe in day.recipes:
+                    result += f"  • {recipe.id} — {recipe.name}\n"
+        return result
+
+    except Exception as e:
+        return f"Failed to get planned recipes: {str(e)}"
+
+
+@mcp.tool()
+async def get_pantry_items() -> str:
+    """
+    Get the list of pantry staples that the user already has at home.
+
+    These ingredients should NOT be added to the shopping cart.
+    Instead, remind the user that they should have them at home.
+
+    Call this tool before building a shopping list to filter out
+    ingredients that don't need to be purchased.
+
+    Returns:
+        str: List of pantry items, one per line, or a message if no pantry file exists.
+    """
+    import os
+    pantry_path = os.environ.get(
+        "PANTRY_PATH",
+        os.path.join(os.path.dirname(os.path.dirname(__file__)), "pantry.txt"),
+    )
+
+    if not os.path.exists(pantry_path):
+        return "No pantry file found. All ingredients should be purchased."
+
+    items = []
+    with open(pantry_path, encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if line and not line.startswith("#"):
+                items.append(line)
+
+    if not items:
+        return "Pantry file is empty. All ingredients should be purchased."
+
+    result = "Pantry staples (DO NOT buy these, user has them at home):\n\n"
+    for item in items:
+        result += f"  • {item}\n"
+    result += f"\nTotal: {len(items)} items. Skip these when building a shopping list."
+    result += "\nNote: Match partially — e.g. 'extra virgin olive oil' matches 'olive oil'."
+    return result
+
