# Cookidoo (Thermomix) credentials
COOKIDOO_EMAIL=your_email@example.com
COOKIDOO_PASSWORD=your_password

# Cookidoo country and language (optional, defaults: cz / cs)
# COOKIDOO_COUNTRY=cz
# COOKIDOO_LANGUAGE=cs

# --- Self-hosting with docker compose ---------------------------------------

# Public host name of the server; its DNS record must point to the VPS
DOMAIN=kitchen.example.com

# Secret that becomes part of the connector URL: https://DOMAIN/MCP_AUTH_TOKEN/mcp
# Generate your own with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Running locally without Docker -----------------------------------------

# Where pantry.txt, products.json and preferences.json live
# (optional, default: the repository root)
# DATA_DIR=/absolute/path/to/data
