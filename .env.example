# Cookidoo (Thermomix) credentials
COOKIDOO_EMAIL=your_email@example.com
COOKIDOO_PASSWORD=your_password

# Cookidoo country and language (optional, defaults: cz / cs)
# COOKIDOO_COUNTRY=cz
# COOKIDOO_LANGUAGE=cs

# --- Self-hosting with docker compose ---------------------------------------

# Secret that becomes part of the connector URL: https://<host>/MCP_AUTH_TOKEN/mcp
# Generate your own with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Tailscale Funnel (docker-compose.yml): an auth key from the Tailscale admin
# console and the machine name; the address will be
# https://TS_HOSTNAME.<your-tailnet>.ts.net
# TS_HOSTNAME may contain only lowercase letters, digits and hyphens. With an
# underscore or a space the Tailscale container keeps restarting.
TS_AUTHKEY=
TS_HOSTNAME=kitchen

# Public host name of the server. Required for the Caddy setup
# (docker-compose.caddy.yml), where its DNS record must point to the VPS.
# Optional with Tailscale: set it to the full ts.net name to refuse requests
# for any other host name.
# DOMAIN=kitchen.example.com

# --- Running locally without Docker -----------------------------------------

# Where pantry.txt, products.json and preferences.json live
# (optional, default: the repository root)
# DATA_DIR=/absolute/path/to/data
