# Cookidoo (Thermomix) credentials
COOKIDOO_EMAIL=your_email@example.com
COOKIDOO_PASSWORD=your_password

# Cookidoo country and language (optional, defaults: cz / cs)
# COOKIDOO_COUNTRY=cz
# COOKIDOO_LANGUAGE=cs

# Rohlik.cz credentials
RHL_EMAIL=your_email@example.com
RHL_PASS=your_password

# Path to the pantry file (optional, default: pantry.txt in this directory)
# PANTRY_PATH=/absolute/path/to/pantry.txt
